-- Sharing metadata, read by tooling and the manager detail pane.
return {
  summary = "Reach the display hotkeys from a controller instead of the keyboard.",
  author = "moonfall-man",
  contact = "https://github.com/moonfall-man/pokemon-couch-multiplayer",
  tags = { "controls", "gamepad", "couch", "accessibility", "display" },
  differences = {
    changed = {
      "nothing about the game: this only presses display toggles you could already press",
    },
    added = {
      "the two stick clicks (L3/R3) and the X/Y face buttons fire a display hotkey of your choosing",
      "one options row per button, so each player picks their own",
    },
    known = {
      "the row labels assume the voxel mod is installed; without it, 3 is TILT and 5 is GBC FX",
      "polls the pad rather than intercepting its events, so it can never swallow an input the game needed",
      "honours PAD_OWNER, so in split screen player 2's stick click only changes player 2's screen",
      "only buttons the engine leaves unbound are offered -- nothing is taken away from the game to make this work",
    },
  },
  compat = { engine = ">=0.1.37 <2.0.0", modApi = 2 },
}
